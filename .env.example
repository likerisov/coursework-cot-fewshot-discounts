# Qwen via Alibaba Cloud Model Studio — Germany (Frankfurt), EU deployment scope.
# Copy this file to .env and replace YOUR_WORKSPACE_ID with the API Host / Workspace ID.
# Create the API key in the SAME Frankfurt workspace. Do not commit .env or share the key.
LLM_API_KEY=paste_your_model_studio_api_key_here
LLM_BASE_URL=https://YOUR_WORKSPACE_ID.eu-central-1.maas.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
